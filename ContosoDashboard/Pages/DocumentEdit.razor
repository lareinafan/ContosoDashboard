@page "/documents/{DocumentId:int}/edit"
@using ContosoDashboard.Services
@using ContosoDashboard.Models
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@using System.ComponentModel.DataAnnotations
@attribute [Authorize]
@inject IDocumentService DocumentService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Edit Document - ContosoDashboard</PageTitle>

<div class="container-fluid">
    @if (document == null)
    {
        @if (notFound)
        {
            <div class="alert alert-warning">
                <span class="bi bi-exclamation-triangle" aria-hidden="true"></span>
                Document not found or you don't have permission to edit it.
            </div>
            <a href="/documents" class="btn btn-secondary">
                <span class="bi bi-arrow-left" aria-hidden="true"></span> Back to Documents
            </a>
        }
        else
        {
            <p><em>Loading...</em></p>
        }
    }
    else
    {
        <div class="row mb-4">
            <div class="col">
                <h1>Edit Document</h1>
                <p class="text-muted">Editing: @document.FileName</p>
            </div>
        </div>

        <div class="row">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-body">
                        <EditForm Model="@editModel" OnValidSubmit="HandleSave">
                            <DataAnnotationsValidator />
                            <ValidationSummary />

                            @if (!string.IsNullOrEmpty(errorMessage))
                            {
                                <div class="alert alert-danger">@errorMessage</div>
                            }

                            <div class="mb-3">
                                <label for="title" class="form-label">Title <span class="text-danger">*</span></label>
                                <InputText id="title" class="form-control" @bind-Value="editModel.Title" />
                                <ValidationMessage For="@(() => editModel.Title)" />
                            </div>

                            <div class="mb-3">
                                <label for="description" class="form-label">Description</label>
                                <InputTextArea id="description" class="form-control" rows="3" @bind-Value="editModel.Description" />
                                <ValidationMessage For="@(() => editModel.Description)" />
                            </div>

                            <div class="mb-3">
                                <label for="category" class="form-label">Category <span class="text-danger">*</span></label>
                                <InputSelect id="category" class="form-select" @bind-Value="editModel.Category">
                                    @foreach (var category in DocumentCategories.All)
                                    {
                                        <option value="@category">@category</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => editModel.Category)" />
                            </div>

                            <div class="mb-3">
                                <label for="tags" class="form-label">Tags</label>
                                <InputText id="tags" class="form-control" @bind-Value="editModel.Tags" placeholder="Comma-separated tags" />
                            </div>

                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-primary">
                                    <span class="bi bi-check-circle" aria-hidden="true"></span> Save Changes
                                </button>
                                <a href="/documents/@DocumentId" class="btn btn-secondary">Cancel</a>
                            </div>
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int DocumentId { get; set; }

    private Document? document;
    private EditModel editModel = new();
    private int currentUserId;
    private bool notFound;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var userIdClaim = user.FindFirst(ClaimTypes.NameIdentifier);
        if (userIdClaim != null && int.TryParse(userIdClaim.Value, out int userId))
        {
            currentUserId = userId;
        }

        if (currentUserId > 0)
        {
            document = await DocumentService.GetDocumentByIdAsync(DocumentId, currentUserId);
            if (document == null || document.UploadedByUserId != currentUserId)
            {
                notFound = true;
                document = null;
            }
            else
            {
                editModel = new EditModel
                {
                    Title = document.Title,
                    Description = document.Description,
                    Category = document.Category,
                    Tags = document.Tags
                };
            }
        }
    }

    private async Task HandleSave()
    {
        errorMessage = null;

        try
        {
            await DocumentService.UpdateDocumentAsync(
                DocumentId,
                editModel.Title,
                editModel.Description ?? "",
                editModel.Category,
                editModel.Tags,
                currentUserId);

            NavigationManager.NavigateTo($"/documents/{DocumentId}");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private class EditModel
    {
        [Required(ErrorMessage = "Title is required")]
        [MaxLength(200, ErrorMessage = "Title cannot exceed 200 characters")]
        public string Title { get; set; } = "";

        [MaxLength(2000, ErrorMessage = "Description cannot exceed 2000 characters")]
        public string? Description { get; set; }

        [Required(ErrorMessage = "Category is required")]
        public string Category { get; set; } = "";

        [MaxLength(500)]
        public string? Tags { get; set; }
    }
}
